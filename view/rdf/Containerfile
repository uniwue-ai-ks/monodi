FROM maven:3-eclipse-temurin-21 AS analyzer-build

RUN apt-get update -q && \
	apt-get install -q -y --no-install-recommends aspell aspell-de && \
	rm -rf /var/lib/apt/lists/* && \
	aspell --lang=de dump master | sed 's/\/.*//' | tr '[:upper:]' '[:lower:]' | sort -u \
	  > /german-words.txt

COPY analyzer /build/
RUN mkdir -p /build/src/main/resources && \
	cp /german-words.txt /build/src/main/resources/ && \
	cd /build && mvn -q package

FROM alpine:latest as tmp

ARG JENA_VERSION=6.1.0
ARG JENA_BASE_URL=https://dlcdn.apache.org
# for older versions use JENA_BASE_URL=https://archive.apache.org/dist

RUN apk add curl && \
	curl -fLo "apache-jena-${JENA_VERSION}.tar.gz" "${JENA_BASE_URL}/jena/binaries/apache-jena-${JENA_VERSION}.tar.gz" && \
	curl -fLo "apache-jena-fuseki-${JENA_VERSION}.tar.gz" \
	"${JENA_BASE_URL}/jena/binaries/apache-jena-fuseki-${JENA_VERSION}.tar.gz" && \
	mkdir -p /opt/app && \
	tar -x -C /opt/app -f "apache-jena-${JENA_VERSION}.tar.gz" && \
	tar -x -C /opt/app -f "apache-jena-fuseki-${JENA_VERSION}.tar.gz" && \
	mv /opt/app/apache-jena-${JENA_VERSION} /opt/app/apache-jena && \
	mv /opt/app/apache-jena-fuseki-${JENA_VERSION} /opt/app/apache-jena-fuseki

FROM eclipse-temurin:25-jre-alpine

ENV FUSEKI_BASE=/opt/app/apache-jena-fuseki

COPY --from=tmp /opt/app /opt/app
COPY --from=analyzer-build /build/target/german-compound-analyzer-1.0.jar \
     /opt/app/apache-jena-fuseki/extra/
COPY entrypoint /opt/app/
COPY fuseki.ttl /opt/app/

RUN mkdir /data

WORKDIR /opt/app
CMD ["sh", "entrypoint"]
