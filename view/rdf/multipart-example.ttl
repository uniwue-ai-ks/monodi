@prefix : <http://olyro.de/mondiview/> .
@prefix data: <http://monodicum/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:version  a rdf:Property.

data:version  rdfs:label rdf:2024-03-05T14:00:37.068686939Z.

# The book class stores information about a whole book
# This includes the title, an id number, year, a PDF, and HTML representation of
# the book, as well as the full plaintext.
data:book
  a rdfs:Class;
  rdfs:label "Bücher"@de,"Books"@en;
  :shortUrlTag "book";
  :disablePrintColumn true;
  :openIIIFText "Faksimile"@de,"Faksimile"@en.

data:bookOcNumber
  a rdf:Property;
  rdfs:label "OC-Nummer"@de,"OC-Number"@en;
  rdfs:domain data:book;
  rdfs:range :string;
  :headerOrder 0;
  :searchOrder 0;
  :documentPosition [ :header 0; :synopsis 0; :right 0 ].

data:bookExternalLink
  a rdf:Property;
  rdfs:label "Wiki-Link"@de,"Wiki-Link"@en;
  rdfs:domain data:book;
  rdfs:range :htmlContent;
  :documentPosition [ :right 8 ].

data:bookTitle
  a rdf:Property;
  rdfs:label "Titel"@de,"Title"@en;
  rdfs:domain data:book;
  rdfs:range :string;
  :headerOrder 1;
  :searchOrder 1;
  :documentPosition [ :header 1 ; :synopsis 1 ].

data:bookYear
  a rdf:Property;
  rdfs:label "Jahr"@de,"Year"@en;
  rdfs:domain data:book;
  rdfs:range :number;
  :headerOrder 2;
  :searchOrder 2;
  :searchSpan true;
  :documentPosition [ :header 2 ; :synopsis 2 ; :right 2 ].

data:bookAuthor
  a rdf:Property;
  rdfs:label "Autor"@de,"Author"@en;
  rdfs:domain data:book;
  rdfs:range :string;
  :headerOrder 3;
  :searchOrder 3;
  :documentPosition [ :header 3 ; :synopsis 3 ].

data:bookPDF
  a rdf:Property;
  rdfs:label "PDF"@de,"PDF"@en;
  rdfs:domain data:book;
  rdfs:range :pdf;
  :documentPosition [ :priority 0 ].

data:bookContent
  a rdf:Property;
  rdfs:label "Inhalt"@de,"Content"@en;
  rdfs:domain data:book;
  rdfs:range :htmlContent;
  :documentPosition [ :main 0 ].

# The fulltext is used for searching, so we don't give a :documentPosition
# Also, we don't want to show the fulltext in the search results, so we don't
# specify a :headerOrder
data:bookFulltext
  a rdf:Property;
  rdfs:label "Inhalt"@de,"Content"@en;
  rdfs:domain data:book;
  :searchOrder 3;
  # If set, a column with the given string as header is shown, containing a
  # preview of the context of the first search match.
  :searchPreview "Erster Treffer"@de, "First match"@en;
  rdfs:range :string.


# The page class stores information about a single page. As a page is always
# part of a book, we specify this relation:
data:page
  a rdfs:Class;
  rdfs:label "Seiten"@de,"Pages"@en;
  # this specifies, that a data:page is part of a data:book
  :referenceClass     data:book;
  # in this attribute, a page will specify the URI of the book it belongs to
  :referenceAttribute data:pageBook;
   # When a :referenceLabel is given, the superclass search will have a link to
   # the subclass search, e.g. each book in a search result will link to the
   # pages search, restricted to pages from the selected book
  :referenceLabel "Seiten durchsuchen"@de, "Seiten durchsuchen"@en;
  :disablePrintColumn true;
  :openIIIFText "Faksimile"@de,"Faksimile"@en.

# the reference attribute, which will contain book URIs. rdfs:range may be
# entity, or, for legacy reasons, :string. If no locations for displaying it are
# specified, both are equivalent. When displaying, an :entity may be rendered as
# a link to the document.
data:pageBook
  a rdf:Property;
  rdfs:label "aus Buch"@de,"from book"@en;
  rdfs:domain data:page;
  rdfs:range :entity.

# a :reference attribute is used to display data from the referenced class.
# Instances should not specify values for attributes of this type, instead
# monodi will use the value from the :referenceAttribute to look up an instance
# of the :referenceClass and display the value of the :referenceField attribute
# for that instance (see below for concrete example)
data:pageRefBook
  a rdf:Property;
  rdfs:domain data:page;
  rdfs:label "Buchtitel"@de,"Book title"@en;
  :headerOrder 0;
  :searchOrder 0;
  rdfs:range :reference;
  :referenceField data:bookTitle;
  :documentPosition [ :header 0; :synopsis 0; :right 0 ].

data:pageNext
  a rdf:Property;
  rdfs:label "nächste Buchseite"@de,"Next book page"@en;
  rdfs:domain data:page;
  rdfs:range :entity;
  :documentPosition [ :right 7; :docNavigation 2 ].

data:pagePrev
  a rdf:Property;
  rdfs:label "vorherige Buchseite"@de,"Previous book page"@en;
  rdfs:domain data:page;
  rdfs:range :entity;
  :documentPosition [ :right 6; :docNavigation 0 ].

data:pageRefAuthor
  a rdf:Property;
  rdfs:domain data:page;
  rdfs:label "Autor"@de,"Author"@en;
  :headerOrder 1;
  :searchOrder 1;
  rdfs:range :reference;
  :referenceField data:bookAuthor;
  :documentPosition [ :header 1; :synopsis 1; :right 1 ].

# A page can still have additional normal attributes
data:pageNumber
  a rdf:Property;
  rdfs:label "Seite"@de,"Page"@en;
  rdfs:domain data:page;
  rdfs:range :number;
  :headerOrder 2;
  :searchOrder 2;
  :searchSpan true;
  :documentPosition [ :header 2 ; :synopsis 2 ; :right 2; :docNavigation 1 ].

# A single page PDF, so we don't have to load the whole book
data:pagePDF
  a rdf:Property;
  rdfs:label "Seite als PDF"@de,"Page as PDF"@en;
  rdfs:domain data:page;
  rdfs:range :pdf;
  :documentPosition [ :priority 0 ].

# Fallback to html representation if there is no pdf
data:pageContent
  a rdf:Property;
  rdfs:label "Inhalt"@de,"Content"@en;
  rdfs:domain data:page;
  rdfs:range :htmlContent;
  :documentPosition [ :main 0 ].

# Text of the single page for searching pages with specific content
data:pageText
  a rdf:Property;
  rdfs:label "Seitentext"@de,"Page text"@en;
  rdfs:domain data:page;
  rdfs:range :string;
  # a property in a subclass can define a corresponding property in the
  # referenced class, even if it isn't a :reference type property. In this case,
  # it isn't used to retrieve content from the superclass, but to match
  # searches. In this example, if a user searches the data:book class by
  # filtering for data:bookFulltext, jumping to the subclass search will prefill
  # the data:pageText field with the search term used for data:bookFulltext.
  :referenceSearch data:bookFulltext;
  :searchPreview "Erster Treffer"@de, "First match"@en;
  :searchOrder 6.

# The full book pdf isn't displayed for a single page, but offered as a download
# link
data:pageFullBookDownload
  a rdf:Property;
  rdfs:label "PDF herunterladen"@de,"PDF herunterladen"@en;
  rdfs:domain data:page;
  rdfs:range :reference;
  :referenceField data:bookPDF;
  :documentPosition [ :download 0 ].


data:camoc0007 a data:book; data:bookOcNumber "oc0006"; data:bookTitle "FOoo"; data:bookYear 1524; data:bookAuthor "Camerarius, Joachim"; data:bookPDF "camoc0006.pdf"; data:bookFulltext """OLYNTHIACA""".
data:camoc0008 a data:book; data:bookOcNumber "oc0006"; data:bookTitle "Ast"; data:bookYear 1524; data:bookAuthor "Camerarius, Joachim"; data:bookPDF "camoc0006.pdf"; data:bookFulltext """OLYNTHIACA""".
data:camoc0009 a data:book; data:bookOcNumber "oc0006"; data:bookTitle "as"; data:bookYear 1524; data:bookAuthor "Camerarius, Joachim"; data:bookPDF "camoc0006.pdf"; data:bookFulltext """OLYNTHIACA""".
data:camoc00010 a data:book; data:bookOcNumber "oc0006"; data:bookTitle "ZZ"; data:bookYear 1524; data:bookAuthor "Camerarius, Joachim"; data:bookPDF "camoc0006.pdf"; data:bookFulltext """OLYNTHIACA""".
data:camoc00011 a data:book; data:bookOcNumber "oc0006"; data:bookTitle "qOoo"; data:bookYear 1524; data:bookAuthor "Camerarius, Joachim"; data:bookPDF "camoc0006.pdf"; data:bookFulltext """OLYNTHIACA""".
