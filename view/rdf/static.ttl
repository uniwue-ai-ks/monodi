:customJavascript :hasContent """
function elemHeight(selector) { return Array.from(document.querySelectorAll(selector)).map((a) => a.offsetHeight).reduce((a,b) => a + b, 0) ; }
function resizeTable() {
    let contentHeight = (window.innerHeight - elemHeight("header") - elemHeight("footer") - elemHeight(".documentHeader") - elemHeight(".searchNavHeader")) + "px"
    let tableBox = document.querySelector("div.tableFixHead")
    if(tableBox) tableBox.style.height = contentHeight
}

window.addEventListener("resize", ev => { resizeTable(); });
window.addEventListener("message", ev => {
  if (typeof ev.data === "object" && "doc" in ev.data) {
        resizeTable();
  }
});
""".
:customCss :hasContent """

body { height: 100%; }
.tableFixHead {
    overflow: auto;
    --col-pad: 16px;
    --col-1-width: 3em;
    --col-2-width: 10em;
    --col-3-width: 3em;
    --col-4-width: 3em;
    --col-5-width: 3em;
}
.tableFixHead table    { table-layout: auto !important; border-collapse: collapse; }
.tableFixHead tbody td, .tableFixHead tbody th { border-width: 2px 0px; border-color: #bbb; border-style: solid;}
table tbody th { padding: 0; }
table tr th:nth-child(1) div { margin: 0; padding: 8px var(--col-pad); width: var(--col-1-width) !important; }
table tr th:nth-child(2) div { margin: 0; padding: 8px var(--col-pad); width: var(--col-2-width) !important; }
table tr th:nth-child(3) div { margin: 0; padding: 8px var(--col-pad); width: var(--col-3-width) !important; }
table tr th:nth-child(4) div { margin: 0; padding: 8px var(--col-pad); width: var(--col-4-width) !important; }
table tr th:nth-child(5) div { margin: 0; padding: 8px var(--col-pad); width: var(--col-5-width) !important; }
.tableFixHead thead { position: sticky; top: 0; z-index: 2; }
.tableFixHead thead tr th:nth-child(1) { position: sticky; left: 0; top: 0; z-index: 3;}
.tableFixHead tbody tr th { position: sticky; z-index: 1; }
.tableFixHead tbody tr th:nth-child(1) { left: 0; }
.tableFixHead tbody tr th:nth-child(2) { left: calc((var(--col-pad)) * 2 + var(--col-1-width)); }
.tableFixHead tbody tr th:nth-child(3) { left: calc((var(--col-pad)) * 4 + var(--col-1-width) + var(--col-2-width)); }
.tableFixHead tbody tr th:nth-child(4) { left: calc((var(--col-pad)) * 6 + var(--col-1-width) + var(--col-2-width) + var(--col-3-width)); }
.tableFixHead tbody tr th:nth-child(5) { left: calc((var(--col-pad)) * 8 + var(--col-1-width) + var(--col-2-width) + var(--col-3-width) + var(--col-4-width)); }
.tableFixHead thead th,  .tableFixHead td     { padding: 8px 16px; }
.tableFixHead th       { background:#eee; }

.app-main { display: flex; flex-direction: column; }
#app-router-outlet { flex-grow: 1; }
#app-router-outlet>div{ heigth: 100%; display: flex; flex-direction: column; }

""".

