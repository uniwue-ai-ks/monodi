:customJavascript :hasContent """
window.addEventListener("message", ev => {

  if (typeof ev.data !== "string") return;

  const [type, data] = ev.data.split(":", 2);

  if (type !== "monodi-open-popup") return;

  const popupButton = document.querySelector("button.open-popup");
  if (!popupButton) return;

  popupButton.click();
  setTimeout(() => {
    const all = document.querySelectorAll("[id^='popup__autoopen__']");
    const current = document.getElementById("popup__autoopen__" + data);

    for (const el of all) {
      el.closest(".monodi-comment-block")?.classList.remove("active");
    }

    current?.closest(".monodi-comment-block")?.classList.add("active");
    current?.closest(".monodi-comment-block")?.scrollIntoView({ behavior: 'smooth', block: 'center' })
  }, 100);
});
""".

data:about
   :position [ :right 0; ];
   :hasTitle "Über uns"@de, "About us"@en, "À propos"@fr;
   :hasRoute "about".

data:impressum
   :position [ :footer 1; ];
   :hasTitle "Impressum"@de, "Imprint"@en, "Impressum"@fr;
   :hasRoute "impressum".

data:foerdervermerk
   :position [ :footer 2; ];
   :hasTitle "Fördervermerk"@de, "Sponsorship"@en, "Fördervermerk"@fr;
   :hasRoute "foerdervermerk".

data:datenschutz
   :position [ :footer 3; ];
   :hasTitle "Datenschutz"@de, "Privacy statement"@en, "Datenschutz"@fr;
   :hasRoute "datenschutz".

data:feedback
   :position [ :footer 4; ];
   :hasTitle "Feedback"@de, "Feedback"@en, "Feedback"@fr;
   :hasRoute "feedback".
