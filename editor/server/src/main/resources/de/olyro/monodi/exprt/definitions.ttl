   :alternativeLink """/search/http%3A%2F%2Fmonodicum%2Fdocument/?hideFromSearch=["http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"]&hideFromTable=["http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"]&query=[{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"%2C"value"%3A"zitiert"}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentTextinitium"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentGattung1"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentFesttag"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentQuelle_id"%2C"value"%3A""}]&pagination={"asc"%3Atrue%2C"limit"%3A10%2C"offset"%3A0%2C"attribute"%3A"http%3A%2F%2Fmonodicum%2FdocumentDokumenten_idA"}""";
   :orderBy "2";
   :conditionalOpenText [
        :property data:publish;
        :check [
                :order 0;
                :value "meta-only";
                :result "anzeigen"
        ];
        :defaultResult "anzeigen"
   ].

data:documentQuelle
    a           rdf:Property ;
    rdfs:label  "Aus Quelle"@de,"From Source"@en,"De la source"@fr  ;
    rdfs:domain data:document  ;
    rdfs:range  :string      .
      
data:documentQuelle_id
    a           rdf:Property ;
    :searchOrder 6 ;
    :documentRightOrder 2 ;
    rdfs:label  "Quellensigle"@de,"Source siglum"@en,"disparue"@fr  ;
    rdfs:domain data:document  ;
    rdfs:range  :category      .
      
data:documentDokumenten_id
    a           rdf:Property ;
    :headerOrder 0 ;
    :searchOrder 0 ;
    :documentPosition [
       :header 4 ;
       :synopsisId 1
    ];
    :alternativeSortAttribute data:documentDokumenten_idA;
    rdfs:label  "Quelle - Folio - Zeile"@de,"Source - Folio - Line"@en,"disparue"@fr  ;
    rdfs:domain data:document  ;
    rdfs:range  :string      .
      

data:documentGattung1
    a           rdf:Property ;
    :headerOrder 1 ;
    :searchOrder 2 ;
    :documentPosition [
       :right 0 ;
       :header 1
    ];
    rdfs:label  "Gattung"@de,"Genre"@en,"disparue"@fr  ;
    rdfs:domain data:document  ;
    rdfs:range  :category      .

data:documentGattung1
   :hasPossibleValue
      [ :value "Agnus"; rdfs:label "Agnus"@de,"Agnus"@en,"Agnus"@fr],
      [ :value "Antiphon"; rdfs:label "Antiphon"@de,"Antiphon"@en,"Antiphon"@fr],
      [ :value "Benedicamus"; rdfs:label "Benedicamus"@de,"Benedicamus"@en,"Benedicamus"@fr],
      [ :value "Credo"; rdfs:label "Credo"@de,"Credo"@en,"Credo"@fr],
      [ :value "Gloria"; rdfs:label "Gloria"@de,"Gloria"@en,"Gloria"@fr],
      [ :value "Humiliate vos"; rdfs:label "Humiliate vos"@de,"Humiliate vos"@en,"Humiliate vos"@fr],
      [ :value "Ite missa est"; rdfs:label "Ite missa est"@de,"Ite missa est"@en,"Ite missa est"@fr],
      [ :value "Kyrie"; rdfs:label "Kyrie"@de,"Kyrie"@en,"Kyrie"@fr],
      [ :value "Lied"; rdfs:label "Lied"@de,"Song"@en,"Chanson"@fr],
      [ :value "Requiescant"; rdfs:label "Requiescant"@de,"Requiescant"@en,"Requiescant"@fr],
      [ :value "Sanctus"; rdfs:label "Sanctus"@de,"Sanctus"@en,"Sanctus"@fr],
      [ :value "Sequenz"; rdfs:label "Sequenz"@de,"Sequence"@en,"Séquence"@fr],
      [ :value "Spiel"; rdfs:label "Spiel"@de,"Play"@en,"Pièce de théâtre"@fr],
      [ :value "Tropus"; rdfs:label "Tropus"@de,"Tropus"@en,"Tropus"@fr].
      
