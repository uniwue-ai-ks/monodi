data:document
   a          rdfs:Class ;
   rdfs:label "Kumulatives Korpus"@de,"Cumulative Corpus"@en,"Corpus cumulatif"@fr ;
   :referenceAttribute data:documentQuelle;
   :referenceClass     data:source;
   :referenceLabel     "Dokumente anzigen"@de,"Show documents"@en,"disparue"@fr ;
   :shortUrlTag "d" ;
   :comparableInSynopsis [];
   :openPopupText "Apparat"@de,"Apparatus"@en,"disparue"@fr ;
   :openIIIFText "Faksimile"@de,"Faksimile"@en,"disparue"@fr ;
   :alternativeLink """/search/http%3A%2F%2Fmonodicum%2Fdocument/?query=[{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentTextinitium"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentGattung1"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentFesttag"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentQuelle_id"%2C"value"%3A""}]&pagination={"asc"%3Atrue%2C"limit"%3A10%2C"offset"%3A0%2C"attribute"%3A"http%3A%2F%2Fmonodicum%2FdocumentDokumenten_idA"}""";
   :orderBy "3";
   :conditionalOpenText [
        :property data:publish;
        :check [
                :order 0;
                :value "meta-only";
                :result "anzeigen"
        ];
        :defaultResult "anzeigen"
   ].

data:documentEdiert
   a          rdfs:Class ;
   rdfs:label "Edition (ED)"@de,"Edition (ED)"@en,"Edition (ED)"@fr ;
   :referenceAttribute data:documentQuelle;
   :referenceClass     data:source;
   :comparableInSynopsis [];
   :openPopupText "Apparat"@de,"Apparatus"@en,"disparue"@fr ;
   :openIIIFText "Handschriftenscan anzeigen"@de,"Show scan of manuscript"@en,"disparue"@fr ;
   :alternativeLink """/search/http%3A%2F%2Fmonodicum%2Fdocument/?hideFromSearch=["http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"]&hideFromTable=["http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"]&query=[{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"%2C"value"%3A"ediert"}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentTextinitium"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentGattung1"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentFesttag"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentQuelle_id"%2C"value"%3A""}]&pagination={"asc"%3Atrue%2C"limit"%3A10%2C"offset"%3A0%2C"attribute"%3A"http%3A%2F%2Fmonodicum%2FdocumentDokumenten_idA"}""";
   :orderBy "0";
   :conditionalOpenText [
        :property data:publish;
        :check [
                :order 0;
                :value "meta-only";
                :result "anzeigen"
        ];
        :defaultResult "anzeigen"
   ].

data:documentTranskribiert
   a          rdfs:Class ;
   rdfs:label "Transkriptionen (TR)"@de,"Transcriptions (TR)"@en,"Transcriptions (TR)"@fr ;
   :referenceAttribute data:documentQuelle;
