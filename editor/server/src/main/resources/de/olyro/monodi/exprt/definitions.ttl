   :alternativeLink """/search/http%3A%2F%2Fmonodicum%2Fdocument/?hideFromSearch=["http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"]&hideFromTable=["http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"]&query=[{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentEditionsstatus"%2C"value"%3A"transkribiert"}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentTextinitium"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentGattung1"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentFesttag"%2C"value"%3A""}%2C{"uri"%3A"http%3A%2F%2Fmonodicum%2FdocumentQuelle_id"%2C"value"%3A""}]&pagination={"asc"%3Atrue%2C"limit"%3A10%2C"offset"%3A0%2C"attribute"%3A"http%3A%2F%2Fmonodicum%2FdocumentDokumenten_idA"}""";
   :orderBy "1";
   :conditionalOpenText [
        :property data:publish;
        :check [
                :order 0;
                :value "meta-only";
                :result "anzeigen"
        ];
        :defaultResult "anzeigen"
   ].

