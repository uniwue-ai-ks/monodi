data:documentEditionsstatus
    a                 rdf:Property ;
    rdfs:label        "Status"@de,"Status"@en,"disparue"@fr  ;
    rdfs:domain       data:document  ;
    rdfs:range        :category    ;
    :searchOrder      7 ;
    :headerOrder      11;
    :documentPosition [ ] ;
    :hasPossibleValue
       [ :value "ediert"; rdfs:label "Edition"@de,"Edition"@en,"disparue"@fr],
       [ :value "zitiert"; rdfs:label "Graduale Synopticum"@de,"Graduale Synopticum"@en,"Graduale Synopticum"@fr],
       [ :value "transkribiert"; rdfs:label "Transkription"@de,"Transcription"@en,"transcribed"@fr];
    :mapValues 
       [ :value "ediert"; rdfs:label "ED"@de,"ED"@en,"ED"@fr],
       [ :value "zitiert"; rdfs:label "GS"@de,"GS"@en,"GS"@fr],
       [ :value "transkribiert"; rdfs:label "TR"@de,"TR"@en,"TR"@fr].

data:documentCriticalApparatus
    a                 rdf:Property ;
    rdfs:label        "Kritischer Apparat"@de,"Critical Apparatus"@en,"disparue"@fr  ;
    rdfs:domain       data:document  ;
    rdfs:range        :htmlImageCollection ;
    :documentPosition [
       :popup 1
    ].

data:fullText
    a              rdf:Property ;
    rdfs:label     "Volltext"@de,"Complete text"@en,"disparue"@fr  ;
    :searchOrder   8 ;
    rdfs:domain    data:document  ;
    :searchPreview [
        :label "Volltext"@de,"Complete text"@en,"disparue"@fr;
        :config [
            :contextKind "words";
            :contextCount 5;
            :maxDistanceRatio 0.5;
        ]
    ];
    :normalization [
        :attribute data:fullTextNormalized;
        :normalizer """value => value.normalize("NFD").replace(/[\\u0300-\\u036f]/g, "").replace(/\\s+/g, "").replace(/-/g, "")"""
    ];
    rdfs:range     :string.

data:fullTextNormalized
    a                 rdf:Property ;
    rdfs:label        "Volltext (normalizisiert)"@de,"Complete text (normalizied)"@en,"Complete text (normalizied)"@fr  ;
    rdfs:domain       data:document  ;
    rdfs:range        :string.

data:pitches
    a                 rdf:Property ;
    rdfs:label        "Tonhöhen"@de,"Pitches"@en,"disparue"@fr  ;
    :searchOrder      9 ;
    rdfs:domain       data:document  ;
    rdfs:range        :substringSearchText.

